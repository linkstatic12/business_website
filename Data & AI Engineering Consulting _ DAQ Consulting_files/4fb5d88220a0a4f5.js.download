Check evaluation results against agreed criteria before approving a release."},{label:"Serve",detail:"Deploy an approved version and monitor quality, latency and failures."}]},{id:"governance",title:"Data Governance",discipline:"Trust",description:"Access policies, lineage and data quality controls across the data estate. The right information, visible to the right people.",technologies:["Policy enforcement","PII masking"],kind:"text",principle:"Define access at the boundary.",Field:i.GovernanceField,decisions:[{label:"Identity",detail:"Identify the user or workload requesting access to the data."},{label:"Policy",detail:"Enforce permitted tables, rows and fields on each consumption path."},{label:"Evidence",detail:"Record lineage, quality checks and access decisions for review."}]}];function r(){return(0,t.jsx)(a.default,{items:s,scope:"core"})}e.s(["default",()=>r])}]);